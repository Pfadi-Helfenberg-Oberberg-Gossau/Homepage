---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import client, { assetUrl } from "@/lib/directus";
import { readItems } from "@directus/sdk";
import { Image } from "astro:assets";

const stufen = await client.request(
  readItems("stufen", {
    filter: {
      status: { _eq: "published" },
      name: { _in: ["Biberstufe", "Wolfsstufe", "Pfadistufe"] },
    },
    fields: ["name", "email", "bild_icon"],
    sort: ["sort"],
  }),
);

const programme = await client.request(
  readItems("program", {
    filter: { status: { _eq: "published" } },
    fields: ["stufe", "Ort", "Startzeit", "Schlusszeit", "Mitnehmen", "Datum", "Enddatum"],
  }),
);

// Latest program per Stufe
const programByStufe = Object.fromEntries(
  stufen.map((s) => [
    s.name,
    programme
      .filter((p) => p.stufe === s.name)
      .sort((a, b) => new Date(b.Datum).getTime() - new Date(a.Datum).getTime())[0],
  ]),
);

function formatDate(datum: string, enddatum?: string | null) {
  const opts: Intl.DateTimeFormatOptions = { day: "numeric", month: "long", year: "numeric" };
  const start = new Date(datum).toLocaleDateString("de-CH", opts);
  if (enddatum) {
    const end = new Date(enddatum).toLocaleDateString("de-CH", opts);
    return `${start} bis ${end}`;
  }
  return start;
}

function formatTime(time: string) {
  return time?.slice(0, 5); // "14:00:00" → "14:00"
}

function formatMitnehmen(value: string | string[]) {
  return Array.isArray(value) ? value.join(", ") : value;
}
---

<Base title="Pfadiaktivität">
  <PageHeader
    title="Pfadiaktivität"
    subtitle="Das aktuelle Programm der einzelnen Stufen."
  />

  <div class="programm-grid">
    {stufen.map((stufe) => {
      const prog = programByStufe[stufe.name];
      const icon = assetUrl(stufe.bild_icon);
      return (
        <article class="programm">
          {icon && <Image class="programm__icon" src={icon} alt="" inferSize />}
          <h2 class="programm__title">{stufe.name}</h2>

          {prog ? (
            <>
              <p class="programm__date">{formatDate(prog.Datum, prog.Enddatum)}</p>
              <dl class="programm__details">
                {prog.Startzeit && (
                  <div>
                    <dt>Startpunkt</dt>
                    <dd>{formatTime(prog.Startzeit)} Uhr, {prog.Ort}</dd>
                  </div>
                )}
                {prog.Schlusszeit && (
                  <div>
                    <dt>Schlusspunkt</dt>
                    <dd>{formatTime(prog.Schlusszeit)} Uhr, {prog.Ort}</dd>
                  </div>
                )}
                {prog.Mitnehmen && (
                  <div>
                    <dt>Mitnehmen / Anziehen</dt>
                    <dd>{formatMitnehmen(prog.Mitnehmen)}</dd>
                  </div>
                )}
              </dl>
            </>
          ) : (
            <p class="programm__empty">Kein aktuelles Programm vorhanden.</p>
          )}

          {stufe.email && (
            <p class="programm__contact">
              Abmelden und bei Fragen:<br />
              <a href={`mailto:${stufe.email}`}>{stufe.email}</a>
            </p>
          )}
        </article>
      );
    })}
  </div>
</Base>

<style>
  .programm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-md);
    align-items: stretch;
  }

  .programm {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
  }

  :global(.programm__icon) {
    width: 140px;
    height: 140px;
    object-fit: contain;
    align-self: center;
    margin-bottom: var(--spacing-sm);
  }

  .programm__title {
    font-size: var(--font-size-2xl);
    text-align: center;
    margin: 0 0 var(--spacing-xs);
  }

  .programm__date {
    font-weight: 700;
    text-align: center;
    margin: 0 auto var(--spacing-md);
  }

  .programm__details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin: 0 0 var(--spacing-md);
  }

  .programm__details dt {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .programm__details dd {
    margin: 0;
  }

  .programm__empty {
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
    margin: 0 auto var(--spacing-md);
  }

  /* Pinned to the bottom so the contact lines up across the cards */
  .programm__contact {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
  }
</style>
