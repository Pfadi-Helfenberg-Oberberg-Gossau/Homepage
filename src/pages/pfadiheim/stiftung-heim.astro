---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { readSingletonSafe } from '@/lib/directus';

// ASSUMPTION: singleton "pfadiheim_stiftung" with a WYSIWYG field "inhalt"
const seite = await readSingletonSafe<{ inhalt?: string }>('pfadiheim_stiftung', ['inhalt']);
---

<Base title="Stiftung Heim">
  <PageHeader title="Stiftung Heim" subtitle="Trägerschaft und Hintergrund des Pfadiheims." />

  {seite?.inhalt ? (
    <div class="prose" set:html={seite.inhalt} />
  ) : (
    <p>Dieser Inhalt wird zurzeit überarbeitet.</p>
  )}
</Base>
