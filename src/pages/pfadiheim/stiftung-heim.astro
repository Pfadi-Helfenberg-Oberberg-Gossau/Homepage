---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PersonGroup from '@/components/PersonGroup.astro';
import { readSingletonSafe } from '@/lib/directus';

const seite = await readSingletonSafe<{ inhalt?: string }>('pfadiheim_stiftung', ['inhalt']);
---

<Base title="Stiftung Heim">
  <PageHeader
    title="Stiftung Heim"
    subtitle="Trägerschaft und Hintergrund des Pfadiheims."
  />

  {seite?.inhalt && (
    <section class="page-section">
      <div class="prose" set:html={seite.inhalt} />
    </section>
  )}

  <PersonGroup collection="stiftungsrat" title="Stiftungsrat" />
</Base>