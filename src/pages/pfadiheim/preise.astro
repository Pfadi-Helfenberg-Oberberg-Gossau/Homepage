---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import client, { readSingletonSafe } from "@/lib/directus";
import { readItems } from "@directus/sdk";

async function getCategories() {
  try {
    return await client.request(
      readItems("pfadiheim_price_categories", {
        filter: { status: { _eq: "published" } },
        fields: [
          "id",
          "name",
          "price_short_camp",
          "price_long_camp",
          "price_minimum_flat",
          "price_day_event",
        ],
        sort: ["sort"],
      }),
    );
  } catch (err) {
    console.error("Preiskategorien fetch failed:", err);
    return [];
  }
}

const categories = await getCategories();
const preiseText = await readSingletonSafe<{
  include_overnight?: string;
  include_day?: string;
  not_included?: string;
}>("pfadiheim_price_inclusions", ["include_overnight", "include_day", "not_included"]);

function formatPrice(value: number | null | undefined): string {
  if (value === null || value === undefined) return "–";
  return `Fr. ${value.toFixed(2)}`;
}
---

<Base title="Preise Pfadiheim">
  <PageHeader
    title="Preise"
    subtitle="Auszug aus der Preisliste. Gültig ist nur die vollständige Preisliste."
  />

  <section class="page-section">
    <h2 class="page-section__title">Lager und Weekend mit Übernachtung</h2>
    <div class="preise-table-scroll">
      <table class="preise-table">
        <thead>
          <tr>
            <th scope="col">Preis pro Person</th>
            <th scope="col">Kurzlager<br />1–3 Nächte</th>
            <th scope="col">Lager über<br />3 Nächte</th>
            <th scope="col">Mindest&shy;pauschale</th>
          </tr>
        </thead>
        <tbody>
          {categories.map((category: any) => (
            <tr>
              <th scope="row">{category.name}</th>
              <td>{formatPrice(category.price_short_camp)}</td>
              <td>{formatPrice(category.price_long_camp)}</td>
              <td>{formatPrice(category.price_minimum_flat)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {preiseText?.include_overnight && (
      <div class="prose prose--small preise-note" set:html={preiseText.include_overnight} />
    )}
  </section>

  <section class="page-section">
    <h2 class="page-section__title">Andere Anlässe ohne Übernachtung</h2>
    <div class="preise-table-scroll">
      <table class="preise-table">
        <thead>
          <tr>
            <th scope="col">Preis pro Anlass</th>
            <th scope="col">Pauschale</th>
          </tr>
        </thead>
        <tbody>
          {categories.map((category: any) => (
            <tr>
              <th scope="row">{category.name}</th>
              <td>{formatPrice(category.price_day_event)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {preiseText?.include_day && (
      <div class="prose prose--small preise-note" set:html={preiseText.include_day} />
    )}
  </section>

  {preiseText?.not_included && (
    <section class="page-section">
      <div class="prose prose--small" set:html={preiseText.not_included} />
    </section>
  )}
</Base>

<style>
  .preise-table-scroll {
    overflow-x: auto;
    max-width: 800px;
  }

  .preise-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .preise-table th,
  .preise-table td {
    padding: 0.625rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .preise-table thead th {
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-border-light);
    vertical-align: bottom;
  }

  .preise-table tbody th {
    font-weight: 600;
  }

  .preise-note {
    margin-top: var(--spacing-sm);
  }
</style>
