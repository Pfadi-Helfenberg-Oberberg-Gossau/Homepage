---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import DownloadList from '@/components/DownloadList.astro';
import { getDownloadCategories } from '@/lib/downloads';

const categories = await getDownloadCategories('pfadiheim_download_categories');
---

<Base title="Dokumente Pfadiheim">
  <PageHeader
    title="Dokumente"
    subtitle="Heimbeschreibung und Bedienungsanleitungen zum Pfadiheim."
  />

  {categories.length > 0 ? (
    <DownloadList categories={categories} />
  ) : (
    <p>Die Dokumente werden zurzeit überarbeitet.</p>
  )}
</Base>
