---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { readSingletonSafe } from '@/lib/directus';

// ASSUMPTION: singleton "pfadiheim_agb" with a WYSIWYG field "inhalt"
const seite = await readSingletonSafe<{ inhalt?: string }>('pfadiheim_agb', ['inhalt']);
---

<Base title="AGB">
  <PageHeader title="AGB" subtitle="Allgemeine Geschäftsbedingungen für die Vermietung des Pfadiheims." />

  {seite?.inhalt ? (
    <div class="prose" set:html={seite.inhalt} />
  ) : (
    <p>Dieser Inhalt wird zurzeit überarbeitet.</p>
  )}
</Base>
