---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import DownloadList from "@/components/DownloadList.astro";
import { getDownloadCategories } from "@/lib/downloads";

const categories = await getDownloadCategories("download_categories");
---

<Base title="Downloads">
  <PageHeader
    title="Downloads"
    subtitle="Hier findest du alle wichtigen Dokumente und Dateien zum Herunterladen."
  />
  <DownloadList categories={categories} />
</Base>
