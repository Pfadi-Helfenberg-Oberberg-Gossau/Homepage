---
import Base from "@/layouts/Base.astro";
import DownloadList from "@/components/DownloadList.astro";
import client from "@/lib/directus";
import { readItems } from "@directus/sdk";

const categories = await client.request(
  readItems("download_categories", {
    filter: { status: { _eq: "published" } },
    fields: [
      "id",
      "name",
      "files.id",
      "files.name",
      "files.sort",
      "files.file.id",
      "files.file.type",
      "files.file.filesize",
    ],
    sort: ["sort"],
  }),
);
---

<Base title="Downloads">
  <div class="container page-content" style="padding-top: 2rem">
    <div style="margin-bottom: 2rem;">
      <h1>Downloads</h1>
      <p style="margin-top: 0.5rem;">
        Hier findest du alle wichtigen Dokumente und Dateien zum Herunterladen.
      </p>
    </div>
    <DownloadList categories={categories} />
  </div>
</Base>