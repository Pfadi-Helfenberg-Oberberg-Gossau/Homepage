---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { readSingletonSafe } from '@/lib/directus';

// ASSUMPTION: singleton "Impressum" with a WYSIWYG field "inhalt"
const seite = await readSingletonSafe<{ inhalt?: string }>('Impressum', ['inhalt']);
---

<Base title="Impressum">
  <PageHeader title="Impressum" />

  {seite?.inhalt ? (
    <div class="prose" set:html={seite.inhalt} />
  ) : (
    <p>Dieser Inhalt wird zurzeit überarbeitet.</p>
  )}
</Base>
