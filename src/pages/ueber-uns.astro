---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import client, { assetUrl } from '@/lib/directus';
import { readSingleton } from '@directus/sdk';
import { Image } from 'astro:assets';

const about = await client.request(readSingleton('about', {
  fields: [
    'intro_text', 'intro_bild',
    'aktivitaeten_text', 'aktivitaeten_bild',
    'werte_text', 'werte_bild',
    'schnuppern_text', 'schnuppern_bild',
    'pfadiheim_text', 'pfadiheim_bild',
  ],
}));

const abschnitte = [
  { text: about.intro_text, bild: about.intro_bild, alt: 'Pfadi Gossau' },
  { text: about.aktivitaeten_text, bild: about.aktivitaeten_bild, alt: 'Pfadiaktivität' },
  { text: about.werte_text, bild: about.werte_bild, alt: 'Unsere Werte' },
  { text: about.schnuppern_text, bild: about.schnuppern_bild, alt: 'Pfadiluft schnuppern' },
  { text: about.pfadiheim_text, bild: about.pfadiheim_bild, alt: 'Pfadiheim' },
].filter((a) => a.text || a.bild);
---

<Base title="Über uns">
  <PageHeader title="Wir stellen uns vor" />

  {abschnitte.map((a) => {
    const bildUrl = assetUrl(a.bild);
    return (
      <section class="abschnitt">
        {bildUrl && (
          <div class="abschnitt__bild">
            <Image src={bildUrl} alt={a.alt} inferSize loading="lazy" />
          </div>
        )}
        {a.text && <div class="abschnitt__text prose" set:html={a.text} />}
      </section>
    );
  })}
</Base>

<style>
  .abschnitt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .abschnitt:first-of-type {
    padding-top: 0;
  }

  .abschnitt:last-of-type {
    border-bottom: none;
  }

  /* Alternate image left / right */
  .abschnitt:nth-of-type(even) .abschnitt__bild {
    order: 2;
  }

  .abschnitt__bild img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 640px) {
    .abschnitt {
      grid-template-columns: 1fr;
    }

    .abschnitt:nth-of-type(even) .abschnitt__bild {
      order: 0;
    }
  }
</style>
