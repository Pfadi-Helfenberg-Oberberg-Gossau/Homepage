---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import client, { assetUrl } from "@/lib/directus";
import { readItems, readSingleton } from "@directus/sdk";
import { Image } from "astro:assets";

const startseite = await client.request(
  readSingleton("Startseite", {
    fields: ["hero", "untertitel", "hero_context"],
  }),
);

const stufen = await client.request(
  readItems("stufen", {
    filter: { status: { _eq: "published" } },
    fields: ["name", "age_range", "description", "leitsatz", "bild_card"],
    sort: ["sort"],
  }),
);

const heroUrl = assetUrl(startseite.hero);
---

<Base title="Startseite">
  <section class="home-hero" slot="hero">
    <h1 class="home-hero__title">{startseite.untertitel}</h1>
    {heroUrl && (
      <figure class="home-hero__figure">
        <Image src={heroUrl} alt={startseite.hero_context ?? "Pfadi Gossau"} inferSize loading="eager" />
        {startseite.hero_context && (
          <figcaption class="container home-hero__caption">{startseite.hero_context}</figcaption>
        )}
      </figure>
    )}
  </section>

  <section class="page-section">
    <h2 class="page-section__title">Unsere Stufen</h2>
    <div class="card-grid">
      {stufen.map((stufe) => (
        <Card
          href={`/stufen/${stufe.name.toLowerCase()}`}
          title={stufe.name}
          image={assetUrl(stufe.bild_card)}
          eyebrow={stufe.age_range}
          description={stufe.description}
          quote={stufe.leitsatz}
        />
      ))}
    </div>
  </section>
</Base>

<style>
  .home-hero {
    padding-top: var(--spacing-lg);
  }

  .home-hero__title {
    text-align: center;
    font-size: clamp(1.5rem, 4vw, var(--font-size-4xl));
    max-width: 720px;
    margin: 0 auto var(--spacing-lg);
    line-height: 1.3;
    padding: 0 var(--spacing-sm);
  }

  .home-hero__figure img {
    width: 100%;
    height: auto;
  }

  .home-hero__caption {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    padding-top: var(--spacing-xs);
  }
</style>
