---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import DownloadList from '@/components/DownloadList.astro';
import PersonGroup from '@/components/PersonGroup.astro';
import { readSingletonSafe } from '@/lib/directus';
import { getAltpfadivereinDokumente } from '@/lib/downloads';

// Singleton "altpfadiverein": inhalt (WYSIWYG), dokumente (Files)
const seite = await readSingletonSafe<{ inhalt?: string }>('altpfadiverein', ['inhalt']);
const dokumente = await getAltpfadivereinDokumente();
---

<Base title="Altpfadiverein">
  <PageHeader title="Altpfadiverein" />

  {seite?.inhalt && (
    <section class="page-section">
      <div class="prose" set:html={seite.inhalt} />
    </section>
  )}

  <DownloadList categories={dokumente} />

  <PersonGroup collection="altpfadiverein_vorstand" title="Vorstand" />
</Base>
