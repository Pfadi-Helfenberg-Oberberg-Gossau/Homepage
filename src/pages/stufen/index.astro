---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Card from '@/components/Card.astro';
import client, { assetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';

const stufen = await client.request(readItems('stufen', {
  filter: { status: { _eq: 'published' } },
  fields: ['name', 'age_range', 'description', 'leitsatz', 'bild_card'],
  sort: ['sort'],
}));
---

<Base title="Unsere Stufen">
  <PageHeader title="Unsere Stufen" />

  <div class="card-grid">
    {stufen.map((stufe) => (
      <Card
        href={`/stufen/${stufe.name.toLowerCase()}`}
        title={stufe.name}
        image={assetUrl(stufe.bild_card)}
        eyebrow={stufe.age_range}
        description={stufe.description}
        quote={stufe.leitsatz}
      />
    ))}
  </div>
</Base>
