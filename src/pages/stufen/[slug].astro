---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import PersonCard from "@/components/PersonCard.astro";
import TeamOverview from "@/components/TeamOverview.astro";
import client, { assetUrl } from "@/lib/directus";
import { readItems } from "@directus/sdk";

export async function getStaticPaths() {
  const stufen = await client.request(
    readItems("stufen", {
      filter: { status: { _eq: "published" } },
      fields: [
        "id",
        "name",
        "age_range",
        "description",
        "leitsatz",
        "long_description",
        "bild_hero",
      ],
      sort: ["sort"],
    }),
  );

  return stufen.map((stufe) => ({
    params: { slug: stufe.name.toLowerCase() },
    props: { stufe },
  }));
}

const { stufe } = Astro.props;

// "Abteilungsleitung" is a Stufe entry in Directus, but its page shows the
// whole team (Abteilungsleitung, all Stufenleitungen, other groups).
const isAbteilungsleitung = stufe.name.toLowerCase() === "abteilungsleitung";

const stufenleitung = await client.request(
  readItems("stufenleitung", {
    filter: { stufe: { _eq: stufe.id }, status: { _eq: "published" } },
    fields: [
      "sort",
      "person.first_name",
      "person.last_name",
      "person.nickname",
      "person.email",
      "person.photo",
    ],
    sort: ["sort"],
  }),
);

const leitpersonen = await client.request(
  readItems("leitpersonen", {
    filter: { stufe: { _eq: stufe.id }, status: { _eq: "published" } },
    fields: [
      "sort",
      "person.first_name",
      "person.last_name",
      "person.nickname",
      "person.photo",
    ],
    sort: ["sort"],
  }),
);
---

<Base title={stufe.name} description={stufe.description}>
  <PageHero
    slot="hero"
    title={stufe.name}
    image={assetUrl(stufe.bild_hero)}
    eyebrow={stufe.age_range}
    quote={stufe.leitsatz}
  />

  {stufe.long_description ? (
    <div class="prose stufe-intro" set:html={stufe.long_description} />
  ) : stufe.description && (
    <p class="stufe-intro stufe-intro--lead">{stufe.description}</p>
  )}

  {isAbteilungsleitung && <TeamOverview />}

  {stufenleitung.length > 0 && (
    <section class="page-section">
      <h2 class="page-section__title">Stufenleitung</h2>
      <div class="person-grid">
        {stufenleitung.map((r) => (
          <PersonCard
            name={`${r.person.first_name} ${r.person.last_name}`}
            nickname={r.person.nickname}
            email={r.person.email}
            photo={assetUrl(r.person.photo)}
          />
        ))}
      </div>
    </section>
  )}

  {leitpersonen.length > 0 && (
    <section class="page-section">
      <h2 class="page-section__title">Leitpersonen</h2>
      <div class="person-grid">
        {leitpersonen.map((r) => (
          <PersonCard
            name={`${r.person.first_name} ${r.person.last_name}`}
            nickname={r.person.nickname}
            photo={assetUrl(r.person.photo)}
          />
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .stufe-intro {
    margin-bottom: var(--spacing-lg);
  }

  .stufe-intro--lead {
    font-size: 1.15rem;
    line-height: 1.7;
    font-weight: 500;
  }
</style>