---
import Base from '@/layouts/Base.astro';
---

<Base title="Kontakt">
  <main class="main-content">
    <div class="container">
      <div class="kontakt-wrapper">
        <h1>Kontakt</h1>
        <p>Mit dem untenstehenden Kontaktformular können Sie uns Anfragen zum Pfadibetrieb, Adressänderungen, Fragen zu den Pfadiaktivitäten und weitere allgemeine Anfragen übermitteln. Alternativ können Sie uns auch direkt per E-Mail unter <a href="mailto:info@pfadigossau.ch">info@pfadigossau.ch</a> erreichen. </p>
        
        <form class="kontakt-form" id="kontakt-form" novalidate>
          <div class="form-group">
            <label for="name">Ihr Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="email">Ihre E-Mail-Adresse</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="betreff">Betreff</label>
            <input type="text" id="betreff" name="betreff" required />
          </div>

          <div class="form-group">
            <label for="nachricht">Ihre Nachricht</label>
            <textarea id="nachricht" name="nachricht" rows="6" required></textarea>
          </div>

          <p class="datenschutz-hinweis">
            Mit dem Absenden dieses Formulars erklären Sie sich mit unserer <a href="/datenschutz">Datenschutzerklärung</a> einverstanden.
          </p>

          <div class="form-status" id="form-status" aria-live="polite"></div>

          <button type="submit" class="btn" id="submit-btn">Nachricht senden</button>
        </form>
        
      </div>
    </div>
  </main>
</Base>

<script>
  const form = document.getElementById('kontakt-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const formData = new FormData(form);
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        status.textContent = 'Ihre Nachricht wurde erfolgreich gesendet. Wir melden uns baldmöglichst bei Ihnen.';
        status.classList.add('form-status--success');
        form.reset();
      } else {
        throw new Error('Fehler beim Senden');
      }
    } catch {
      status.textContent = 'Beim Senden ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.';
      status.classList.add('form-status--error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Nachricht senden';
    }
  });
</script>

<style>
  .kontakt-wrapper {
    max-width: 640px;
    padding: var(--spacing-lg) 0;
    margin: auto;
  }

  .kontakt-form {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  label {
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  input, textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text);
    background-color: var(--color-background);
    transition: border-color var(--transition-fast);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  .datenschutz-hinweis {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .form-status {
    font-size: var(--font-size-sm);
    padding: 0.75rem;
    border-radius: var(--border-radius);
    display: none;
  }

  .form-status:not(:empty) {
    display: block;
  }

  .form-status--success {
    background-color: #f0faf0;
    color: #2d6a2d;
    border: 1px solid #b6ddb6;
  }

  .form-status--error {
    background-color: #fdf0f0;
    color: #8b2020;
    border: 1px solid #e8b4b4;
  }
</style>