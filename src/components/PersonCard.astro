---
interface Props {
  name: string;
  nickname?: string;
  role?: string;
  email?: string;
  photo?: string;
}

const { name, nickname, role, email, photo } = Astro.props;
const initials = `${name.split(' ')[0][0]}${name.split(' ')[1]?.[0] ?? ''}`
---

<div class="card">
  {photo 
    ? <img src={photo} alt={name} class="portrait" />
    : <div class="portrait initials">{initials}</div>
  }
  <h3>{name}</h3>
  {nickname && <p class="nickname">v/o {nickname}</p>}
  {role && <p class="role">{role}</p>}
  {email && <a href={`mailto:${email}`}>{email}</a>}
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xs);
  }

  .portrait {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }

  .initials {
    background-color: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
  }

  .nickname {
    font-style: italic;
    opacity: 0.7;
    font-size: 0.9rem;
  }

  .role {
    opacity: 0.7;
    font-size: 0.9rem;
  }

  a {
    font-size: 0.85rem;
  }
</style>