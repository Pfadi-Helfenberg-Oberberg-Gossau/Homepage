---
// One linked card for everything: Stufen, Pfadiheim subpages, ...
// Replaces StufeCard and SectionCard. Every part except title and href is optional.
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  image?: string;
  /** Small line above the title, e.g. "5 – 7 Jahre" */
  eyebrow?: string;
  description?: string;
  /** Rendered in guillemets at the bottom of the card, e.g. the Leitsatz */
  quote?: string;
}

const { href, title, image, eyebrow, description, quote } = Astro.props;
---

<a href={href} class="card">
  {image && (
    <div class="card__image">
      <Image src={image} alt="" loading="lazy" inferSize />
    </div>
  )}
  <div class="card__body">
    {eyebrow && <span class="card__eyebrow">{eyebrow}</span>}
    <h3 class="card__title">{title}</h3>
    {description && <p class="card__description">{description}</p>}
    {quote && <p class="card__quote">«{quote}»</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--transition-base);
  }

  .card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    text-decoration: none;
    opacity: 1;
  }

  .card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border-light);
  }

  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s;
  }

  .card:hover .card__image img {
    transform: scale(1.03);
  }

  .card__body {
    padding: var(--spacing-sm);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    flex: 1;
  }

  .card__eyebrow {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card__title {
    font-size: var(--font-size-xl);
    margin: 0;
  }

  .card__description {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0;
  }

  .card__quote {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-style: italic;
    margin: auto 0 0;
    padding-top: var(--spacing-xs);
  }
</style>
