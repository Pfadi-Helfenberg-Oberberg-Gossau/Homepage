---
import client from "@/lib/directus";
import { readSingleton } from "@directus/sdk";
import { Icon } from "astro-icon/components";

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;

const settings = await client.request(
  readSingleton("Einstellungen", {
    fields: [
      "logo_sgarai",
      "logo_sgarai_url",
      "logo_pbs",
      "logo_pbs_url",
      "logo_igsport",
      "logo_igsport_url",
      "logo_sportvereint",
      "logo_sportvereint_url",
      "facebook_url",
      "instagram_url",
    ],
  }),
);

const logos = [
  {
    img: settings.logo_sgarai,
    url: settings.logo_sgarai_url,
    alt: "Kantonalverband SG/AR/AI",
  },
  { img: settings.logo_pbs, url: settings.logo_pbs_url, alt: "PBS" },
  {
    img: settings.logo_igsport,
    url: settings.logo_igsport_url,
    alt: "IG Sport SG",
  },
  {
    img: settings.logo_sportvereint,
    url: settings.logo_sportvereint_url,
    alt: "Sport verein-t",
  },
].filter((l) => l.img);
---

<footer>
  <div class="container">
    <div class="footer-main">
      <div class="footer-col">
        <h3>Pfadi Gossau</h3>
        <p>Helfenberg-Oberberg</p>
        <p>9200 Gossau SG</p>
      </div>
      <div class="footer-col">
        <h3>Kontakt</h3>
        <p><a href="mailto:info@pfadigossau.ch">info@pfadigossau.ch</a></p>
      </div>
      <div class="footer-col">
        <h3>Folgt uns</h3>
        <div class="social">
          {
            settings.instagram_url && (
              <a
                href={settings.instagram_url}
                aria-label="Instagram"
                target="_blank"
                rel="noopener"
              >
                <Icon name="mdi:instagram" size={24} />
              </a>
            )
          }
          {
            settings.facebook_url && (
              <a
                href={settings.facebook_url}
                aria-label="Facebook"
                target="_blank"
                rel="noopener"
              >
                <Icon name="mdi:facebook" size={24} />
              </a>
            )
          }
        </div>
      </div>
    </div>

    {
      logos.length > 0 && (
        <div class="footer-logos">
          {logos.map((logo) => (
            <a
              href={logo.url ?? "#"}
              target="_blank"
              rel="noopener"
              aria-label={logo.alt}
            >
              <img src={`${DIRECTUS_URL}/assets/${logo.img}`} alt={logo.alt} />
            </a>
          ))}
        </div>
      )
    }

    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Pfadi Gossau. Alle Rechte vorbehalten.</p>
      <nav class="footer-links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutzerklärung</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-primary);
    color: var(--color-text-light);
    padding: var(--spacing-md) 0;
    margin-top: var(--spacing-lg);
  }
  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }
  h3 {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xs);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  p,
  a {
    color: var(--color-text-light);
    opacity: 0.85;
    font-size: 0.85rem;
    line-height: 1.8;
  }
  a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .social {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
  }
  .social a {
    display: flex;
    align-items: center;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .social a:hover {
    opacity: 1;
    text-decoration: none;
  }
  .footer-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-md) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--spacing-sm);
  }
  .footer-logos img {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .footer-logos a:hover img {
    opacity: 1;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-sm);
    opacity: 0.6;
    font-size: 0.75rem;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .footer-links {
    display: flex;
    gap: var(--spacing-sm);
  }

  .footer-links a {
    font-size: 0.75rem;
    opacity: 1;
  }
</style>
