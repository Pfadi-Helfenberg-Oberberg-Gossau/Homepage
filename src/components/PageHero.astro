---
// Full-bleed image hero (the Stufen look). Put it in Base's hero slot:
//   <PageHero slot="hero" image={url} title="…" eyebrow="…" quote="…" />
// Without an image it falls back to the plain PageHeader, so pages don't
// need their own if/else.
import { Image } from 'astro:assets';
import PageHeader from './PageHeader.astro';

interface Props {
  title: string;
  image?: string;
  /** Small line above the title, e.g. the age range */
  eyebrow?: string;
  /** Rendered in guillemets below the title, e.g. the Leitsatz */
  quote?: string;
}

const { title, image, eyebrow, quote } = Astro.props;
---

{image ? (
  <div class="page-hero">
    <Image src={image} alt="" inferSize loading="eager" />
    <div class="page-hero__overlay">
      <div class="container page-hero__inner">
        <div class="page-hero__text">
          {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
          <h1 class="page-hero__title">{title}</h1>
          {quote && <p class="page-hero__quote">«{quote}»</p>}
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="container page-hero--plain">
    <PageHeader title={title} subtitle={eyebrow} />
  </div>
)}

<style>
  .page-hero {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
  }

  .page-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.1) 60%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--spacing-md);
  }

  .page-hero__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-hero__text {
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--border-radius);
    text-align: center;
  }

  .page-hero__eyebrow {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    margin: 0 auto var(--spacing-xs);
  }

  .page-hero__title {
    font-size: var(--font-size-4xl);
    color: var(--color-text-light);
    margin: 0 0 var(--spacing-xs);
  }

  .page-hero__title:last-child {
    margin-bottom: 0;
  }

  .page-hero__quote {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    margin: 0 auto;
  }

  /* The fallback header sits in the hero slot, and Base already adds
     space after the hero, so drop the header's own bottom margin */
  .page-hero--plain :global(.page-header) {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .page-hero {
      height: 300px;
    }

    .page-hero__title {
      font-size: 1.75rem;
    }
  }
</style>
