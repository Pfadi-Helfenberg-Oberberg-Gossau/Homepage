---
import { File, Download } from '@lucide/astro';

interface Props {
  categories: any[];
}

const { categories } = Astro.props;
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;

function getFileType(mimeType: string): string {
  if (mimeType?.includes("pdf")) return "PDF";
  if (mimeType?.includes("word") || mimeType?.includes("docx")) return "DOCX";
  if (mimeType?.includes("spreadsheet") || mimeType?.includes("xlsx")) return "XLSX";
  if (mimeType?.includes("image")) return "IMG";
  return "FILE";
}

function formatFilesize(bytes: number): string {
  if (!bytes) return "";
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

{categories.map((category: any) => (
  <section class="page-section">
    <h2 class="page-section__title">{category.name}</h2>
    <ul class="download-list">
      {category.files
        ?.filter((f: any) => f.file)
        .sort((a: any, b: any) => a.sort - b.sort)
        .map((f: any) => (
          <li>
            <a class="download-card" href={`${DIRECTUS_URL}/assets/${f.file.id}?download`}>
              <span class="download-card__icon"><File size={24} /></span>
              <span class="download-card__info">
                <span class="download-card__name">{f.name}</span>
                <span class="download-card__meta">
                  <span class="download-card__type">{getFileType(f.file.type)}</span>
                  {f.file.filesize && (
                    <span class="download-card__size">{formatFilesize(f.file.filesize)}</span>
                  )}
                </span>
              </span>
              <span class="download-card__action"><Download size={18} /></span>
            </a>
          </li>
        ))}
    </ul>
  </section>
))}

<style>
  .download-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-width: 720px;
  }

  .download-list li {
    margin: 0;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.875rem var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .download-card:hover {
    background-color: var(--color-border-light);
    border-color: var(--color-accent);
    text-decoration: none;
    opacity: 1;
  }

  .download-card__icon {
    display: flex;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .download-card__info {
    flex: 1;
    min-width: 0;
  }

  .download-card__name {
    display: block;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .download-card__meta {
    display: flex;
    gap: var(--spacing-xs);
    margin-top: 0.125rem;
  }

  .download-card__type {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-border-light);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  .download-card__size {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    align-self: center;
  }

  .download-card__action {
    display: flex;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .download-card:hover .download-card__action {
    color: var(--color-primary);
  }
</style>
