---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a href={href} class="section-card">
  {image && (
    <div class="section-card__image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="section-card__body">
    <h3 class="section-card__title">{title}</h3>
    <p class="section-card__description">{description}</p>
  </div>
</a>

<style>
  .section-card {
    display: flex;
    flex-direction: column;
    border: 0.5px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }

  .section-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    text-decoration: none;
  }

  .section-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border);
  }

  .section-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s;
  }

  .section-card:hover .section-card__image img {
    transform: scale(1.03);
  }

  .section-card__body {
    padding: var(--spacing-sm);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    flex: 1;
  }

  .section-card__title {
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .section-card__description {
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.8;
    line-height: 1.6;
  }
</style>